# Copy this file's contents into Render's Environment tab (not into git).

# From @BotFather after creating your bot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any long random string you make up yourself — keeps random people
# on the internet from POSTing fake receipts to your bot.
WEBHOOK_SECRET=change-me-to-something-random

# The full JSON key file content from your Google service account,
# pasted as a single line (see README "Google Sheet setup").
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "...": "..."}

# The long ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=your-google-sheet-id

# Optional: comma-separated Telegram numeric user IDs of your family
# members. Get each person's ID by having them message @userinfobot.
# Leave blank while testing.
ALLOWED_USER_IDS=111111111,222222222

# Free API key from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=your_free_key_here


# Free API key from Groq (console.groq.com) - fallback when Gemini quota is exceeded
GROQ_API_KEY=your_groq_key_here

